SUPABASE_URL=
SUPABASE_ANON_KEY=
# Aliases also accepted: SUPABASE_PUBLISHABLE_KEY, NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE=
# Aliases also accepted: SUPABASE_SERVICE_ROLE_KEY, SUPABASE_SECRET_KEY
# Server only. Never prefix with NEXT_PUBLIC_ and never put these in client code.
GEMINI_API_KEY=
# Optional extras. Server tries GEMINI_API_KEY, then _2 … _9 on 401/403/429/5xx.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=
# GEMINI_API_KEY_6=
# GEMINI_API_KEY_7=
# GEMINI_API_KEY_8=
# GEMINI_API_KEY_9=
GROQ_API_KEY=
# LLM principal do /api/gen/chat. gemini (padrão) ou groq.
# GEN_CHAT_PRIMARY=gemini
# Cidade padrão do get_weather (Open-Meteo, sem chave).
# GEN_DEFAULT_CITY=Taboão da Serra
# Gemini Live prebuilt voice. Default Charon (male). Server only.
GEN_VOICE_NAME=Charon
# Palavrões leves da Gen. Default on. 0/false/off desliga no servidor.
GEN_PROFANITY=on
# Opcional. Sem chave, web_search usa DuckDuckGo + Wikipedia.
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# Protege GET/POST /api/routines no cron (Vercel também envia x-vercel-cron).
# CRON_SECRET=
# Unused in this MVP. /admin is open and does not read ADMIN_SECRET.
# Set it again only after the PIN check in api/admin/session.js is restored.
# ADMIN_SECRET=
GOOGLE_SITE_VERIFICATION=
# Broker MQTT (WSS). EMQX Cloud Serverless: wss://<host>:8084/mqtt
# Qualquer broker MQTT serve. Sem estas variáveis o publish é no-op.
# Falha/timeout (~2s) só gera warning.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
# MQTT_TOPIC=
# MQTT_TLS_INSECURE=
# Só para teste local (força o código da sessão ativa; nunca use JFYBZH em produção).
# MQTT_ACTIVE_SESSION=
