{
  "buildCommand": "node scripts/inject-gsc.js",
  "outputDirectory": ".",
  "trailingSlash": false,
  "crons": [
    { "path": "/api/routines/run", "schedule": "*/5 * * * *" }
  ],
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/gen", "destination": "/gen.html" },
    { "source": "/casa", "destination": "/casa.html" },
    { "source": "/s/:code", "destination": "/summary.html" }
  ]
}
