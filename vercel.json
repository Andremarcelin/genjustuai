{
  "buildCommand": "node scripts/inject-gsc.js",
  "outputDirectory": ".",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/s/:code", "destination": "/summary.html" }
  ]
}
